rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Punch selfies: employees can create (never overwrite) their own.
    match /selfies/{uid}/{file} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && isImage();
      allow delete: if isAdmin();
    }

    // Reference face photos.
    match /faces/{uid}/{file} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && isImage();
      allow delete: if isAdmin();
    }
  }
}
