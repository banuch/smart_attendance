{
  "name": "smart-attendance-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API + MySQL backend for Smart Attendance",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/migrate.js && node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "create-admin": "node --env-file-if-exists=.env src/cli/create-admin.js",
    "test": "node --test --test-concurrency=1",
    "test:api": "node --env-file=.env.test --test --test-concurrency=1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
