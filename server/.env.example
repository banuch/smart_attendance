# Copy to .env and fill in. Never commit .env.

# MySQL. From inside Docker, the VM's own MySQL is host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=smart_attendance
DB_USER=attendance
DB_PASSWORD=change-me

# Signs login tokens and photo links. Generate with: openssl rand -hex 32
JWT_SECRET=
# How long a login lasts on a phone or browser.
TOKEN_TTL=30d

# Public HTTPS origin of the site (used in photo links).
PUBLIC_URL=https://attendance.example.com
# Extra browser origins allowed to call the API (comma separated).
# localhost is always allowed for development.
CORS_ORIGINS=

# Decides which calendar day a punch belongs to, e.g. Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata

# Cosine similarity needed for a face match (MobileFaceNet).
FACE_MATCH_THRESHOLD=0.55
# Punches with worse GPS accuracy (metres) are accepted but flagged.
MAX_GPS_ACCURACY_METERS=50

# Only used outside Docker (npm run dev).
PORT=8080
UPLOAD_DIR=./uploads
